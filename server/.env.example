# Copy to server/.env and fill in. Never commit .env.
PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017/clario

# Strata: local OpenAI-compatible server. No web search or fetching in the beta.
LLM_BASE_URL=http://127.0.0.1:8080/v1
# Model id as reported by GET ${LLM_BASE_URL}/models
LLM_MODEL=
# Local servers usually ignore it, but it never goes in the client or a log.
LLM_API_KEY=

# Vite dev server origin, allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173
