# Copy to server/.env and fill in. Never commit .env — it is git-ignored, and the only place a
# secret may live.
#
# Parsed in exactly one place: server/config/env.js. A value left blank keeps the default noted
# below. MONGO_URL and JWT_SECRET have no safe default: the server refuses to start without them
# and says which one is missing (never the value).

# development | production. `production` also turns the session cookie's Secure flag on.
NODE_ENV=development

# Port the API listens on. Default 3000.
PORT=

# MongoDB connection string. Required.
#   local: mongodb://127.0.0.1:27017/clario
#   Atlas: mongodb+srv://<user>:<password>@<cluster>/clario?retryWrites=true&w=majority
MONGO_URL=

# Signs the JWT carried in the httpOnly session cookie. Required, at least 32 characters.
# Generate one and paste it — do not invent it by hand:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a session cookie stays valid, as a duration ("7d", "12h", "30m"). Default 7d.
JWT_EXPIRES_IN=

# "true" adds Secure to the session cookie (https only). Blank follows NODE_ENV: false in
# development, true in production. Set it explicitly if the deployment is https behind a proxy
# while NODE_ENV is not "production".
COOKIE_SECURE=

# Cookie SameSite policy. Blank follows NODE_ENV: lax locally, none in production.
COOKIE_SAME_SITE=

# The admin account the seeding step creates, and the account the roles are checked against.
# Leave both blank to skip seeding. Never reuse the student password length policy here.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Exact browser origin allowed by CORS — scheme, host and port, no wildcard. Default
# http://localhost:5173. A mismatch reads in the browser as "cannot reach the server".
CLIENT_ORIGIN=

# Strata: local OpenAI-compatible server. No web search or fetching in the beta.
LLM_BASE_URL=

# Model id as reported by GET ${LLM_BASE_URL}/models
LLM_MODEL=

# Local servers usually ignore it, but it never goes in the client or a log.
LLM_API_KEY=

# Milliseconds before a single completion is abandoned. Default 90000. Raise it for a model that
# needs longer to produce a full concept graph or question list.
LLM_TIMEOUT_MS=

# Requests allowed per address per window. Defaults 60 per 60000 ms. Raise both for a demo where
# several people share one address, such as a campus or lab NAT.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
